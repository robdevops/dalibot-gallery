# dalibot-gallery configuration. Copy to .env and fill in the secrets.
#
# Used as it is by Docker (--env-file, Compose env_file) and by systemd
# (EnvironmentFile): one NAME=value per line, no quotes, no "export".
# Every value is checked at start-up; a mistake stops the gallery with a
# message that names the variable. Lines that are commented out show the default.

# ---- Required ---------------------------------------------------------------

# Who can view. Set exactly one of these two; the gallery refuses to start
# with neither (so it is never open by accident) and with both.
#
# The shared token for viewing: the password of the login page and of HTTP
# Basic. At least 16 characters. Make one with: openssl rand -base64 32
GALLERY_TOKEN=
# Or: 1 lets anyone who can reach the gallery view it, with no login.
#GALLERY_PUBLIC=1

# The bot's token. The gallery uses it only for getFile and the file download.
TELEGRAM_BOT_TOKEN=

# ---- The bot's records ------------------------------------------------------

# Where the bot keeps them: dynamodb (the bot's table in AWS) or sqlite (the
# database file of a self-hosted bot). Only the chosen one's settings are read.
#GALLERY_SOURCE=dynamodb

# With dynamodb: a read-only AWS identity (see docs/aws-access.md). Any source
# in the standard AWS chain works; with access keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Instead of keys, a profile from a mounted ~/.aws:
#AWS_PROFILE=
#AWS_REGION=ap-southeast-1
#DALIBOT_TABLE=dalibot

# With sqlite: remove the AWS lines above, set GALLERY_SOURCE=sqlite, and give
# the bot's database file (the bot's DALIBOT_DB). It is opened read-only. With
# deploy/compose.sqlite.yaml the path is set there; leave it unset here.
# See docs/sqlite.md.
#GALLERY_SQLITE_PATH=/opt/dalibot/var/dalibot.db

# Must equal the bot's DALIBOT_STORE_DAYS. With dynamodb the gallery works out
# each image's date as ttl minus this many days; with sqlite it is how old a
# row may be before it counts as expired.
#GALLERY_STORE_DAYS=90

# Shown for records that have no command of their own (the bot's TELEGRAM_BOT_COMMAND).
#GALLERY_DEFAULT_COMMAND=dream

# Comma list of chat ids to show (negative for groups), e.g. -1001234567890,12345.
# Empty shows every chat.
#GALLERY_CHATS=

# ---- Server -----------------------------------------------------------------

# host:port. In the container this is fixed to 0.0.0.0:8080 by the image and by
# deploy/compose.yaml; leave it unset there.
#GALLERY_LISTEN=127.0.0.1:8080

# The addresses your reverse proxy connects from, as the gallery sees them:
# a comma list of IPs or CIDR ranges. Only from these is X-Forwarded-For
# believed, for the limit on wrong tokens per client and for the log.
# Default: loopback, which suits a proxy on the same host without a container.
# deploy/compose.yaml sets it to its network's gateway and overrides this.
# "none" trusts nobody. See docs/reverse-proxy.md.
#GALLERY_TRUSTED_PROXIES=127.0.0.0/8,::1

# Who can administer: nobody, unless this is set. A second token, different
# from GALLERY_TOKEN and at least 16 characters, used at the same login page
# (or as the HTTP Basic password). Works with GALLERY_TOKEN and with
# GALLERY_PUBLIC=1.
#GALLERY_ADMIN_TOKEN=

# GALLERY_AUTH no longer exists; the gallery refuses to start if it is set.
# GALLERY_PUBLIC=1 above replaces GALLERY_AUTH=off.

# How often the bot's records are re-read: a duration (60s, 2m) or a number of seconds.
# Between 5s and 24h.
#GALLERY_REFRESH=60s

# Set to 1 to log at debug level, including every image and asset request.
#GALLERY_DEBUG=

# ---- Images and cache -------------------------------------------------------

# Where originals and thumbnails are kept. Default: $CACHE_DIRECTORY (set by
# systemd) or ./cache. In the container it is fixed to /var/cache/dalibot-gallery.
#GALLERY_CACHE_DIR=

# Where the list of images an admin has hidden is kept (docs/admin.md). This
# is state, not cache: keep it. Default: $STATE_DIRECTORY (set by systemd's
# StateDirectory=), else the cache directory, with a warning at start-up. In
# the container it is fixed to /var/lib/dalibot-gallery.
#GALLERY_STATE_DIR=

# Size limit for originals plus thumbnails (minimum 16). Above it thumbnails
# are evicted, least recently used first; originals are not, so allow about
# 355 KB per image the bot has recorded. See docs/cache.md.
#GALLERY_CACHE_MAX_MB=2048

# WebP quality of the thumbnails, 1-100. Changing it changes every thumbnail URL.
#GALLERY_WEBP_QUALITY=76

# Thumbnail pipelines that may run at once, 1-64. Default: the CPUs available to the process
# (the machine's, or fewer under a container CPU limit).
#GALLERY_IMAGE_WORKERS=

# How many of the newest tiles get their thumbnails made in the background
# after each refresh. 0 turns the warmer off.
#GALLERY_WARM=120

# ---- Telegram ---------------------------------------------------------------

# Only for a local Bot API server or for tests.
#TELEGRAM_API_BASE=https://api.telegram.org
