# dalibot-gallery configuration. Copy to .env and fill in the three secrets.
#
# Used as it is by Docker (--env-file, Compose env_file) and by systemd
# (EnvironmentFile): one NAME=value per line, no quotes, no "export".
# Every value is checked at start-up; a mistake stops the gallery with a
# message that names the variable. Lines that are commented out show the default.

# ---- Required ---------------------------------------------------------------

# The shared access token: the password of the login page and of HTTP Basic.
# At least 16 characters. Make one with: openssl rand -base64 32
GALLERY_TOKEN=

# The bot's token. The gallery uses it only for getFile and the file download.
TELEGRAM_BOT_TOKEN=

# A read-only AWS identity (see docs/aws-access.md). Any source in the
# standard AWS chain works; with access keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Instead of keys, a profile from a mounted ~/.aws:
#AWS_PROFILE=

# ---- The bot's table --------------------------------------------------------

#AWS_REGION=ap-southeast-1
#DALIBOT_TABLE=dalibot

# Must equal the bot's DALIBOT_STORE_DAYS: the gallery works out each image's
# date as ttl minus this many days.
#GALLERY_STORE_DAYS=90

# Shown for records that have no command of their own (the bot's TELEGRAM_BOT_COMMAND).
#GALLERY_DEFAULT_COMMAND=dream

# Comma list of chat ids to show (negative for groups), e.g. -1001234567890,12345.
# Empty shows every chat in the table.
#GALLERY_CHATS=

# ---- Server -----------------------------------------------------------------

# host:port. In the container this is fixed to 0.0.0.0:8080 by the image and by
# deploy/compose.yaml; leave it unset there.
#GALLERY_LISTEN=127.0.0.1:8080

# The addresses your reverse proxy connects from, as the gallery sees them:
# a comma list of IPs or CIDR ranges. Only from these is X-Forwarded-For
# believed, for the limit on wrong tokens per client and for the log.
# Default: loopback, which suits a proxy on the same host without a container.
# deploy/compose.yaml sets it to its network's gateway and overrides this.
# "none" trusts nobody. See docs/reverse-proxy.md.
#GALLERY_TRUSTED_PROXIES=127.0.0.0/8,::1

# Set to "off" (and leave GALLERY_TOKEN unset) only when a reverse proxy in
# front authenticates every request. The gallery then has no login at all.
#GALLERY_AUTH=

# How often the table is re-read: a duration (60s, 2m) or a number of seconds.
# Between 5s and 24h.
#GALLERY_REFRESH=60s

# Set to 1 to log at debug level, including every image and asset request.
#GALLERY_DEBUG=

# ---- Images and cache -------------------------------------------------------

# Where originals and thumbnails are kept. Default: $CACHE_DIRECTORY (set by
# systemd) or ./cache. In the container it is fixed to /var/cache/dalibot-gallery.
#GALLERY_CACHE_DIR=

# Size limit for originals plus thumbnails (minimum 16). Above it thumbnails
# are evicted, least recently used first; originals are not, so allow about
# 355 KB per image in the table. See docs/cache.md.
#GALLERY_CACHE_MAX_MB=2048

# WebP quality of the thumbnails, 1-100. Changing it changes every thumbnail URL.
#GALLERY_WEBP_QUALITY=76

# Thumbnail pipelines that may run at once, 1-64. Default: the CPUs available to the process
# (the machine's, or fewer under a container CPU limit).
#GALLERY_IMAGE_WORKERS=

# How many of the newest tiles get their thumbnails made in the background
# after each refresh. 0 turns the warmer off.
#GALLERY_WARM=120

# ---- Telegram ---------------------------------------------------------------

# Only for a local Bot API server or for tests.
#TELEGRAM_API_BASE=https://api.telegram.org
